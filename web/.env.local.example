# Public Content/Gallery data — published via Google Sheets "File > Share >
# Publish to web" (per tab, CSV format). These URLs are not secret; the data
# behind them is meant to be public.
CONTENT_CSV_URL=https://docs.google.com/spreadsheets/d/e/PASTE_PUBLISHED_ID/pub?gid=CONTENT_TAB_GID&single=true&output=csv
GALLERY_CSV_URL=https://docs.google.com/spreadsheets/d/e/PASTE_PUBLISHED_ID/pub?gid=GALLERY_TAB_GID&single=true&output=csv

# People data — read via the authenticated Google Sheets API (server-side
# only, see src/lib/sheetsApi.ts). Keep these secret: the data behind them is
# full name/DOB/address for thousands of residents.
GOOGLE_SHEETS_API_KEY=your-restricted-api-key
PEOPLE_SHEET_ID=the-sheet-id-from-the-sheets-url

# Staff login gate (one shared password for the whole office, see
# src/lib/staffAuth.ts). Keep both secret. SESSION_SECRET can be any long
# random string -- it signs the login cookie, it's not something anyone types.
STAFF_PASSWORD=choose-a-password
SESSION_SECRET=a-long-random-string
